	<key>%lld öğe sıkıştırıldı; %@ kazanıldı. Hiçbir şey silinmedi, tüm yollar çalışmaya devam ediyor.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@; %@ saved. Nothing was deleted and every path keeps working.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item compressed</string>
			<key>other</key>
			<string>%lld items compressed</string>
		</dict>
	</dict>
	<key>Klasördeki %lld dosya başka dosyalarla aynı alanı paylaşıyor (sabit bağ veya APFS klonu); sıkıştırmak bu paylaşımı bozar. Dokunulmadı.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld file in the folder shares its space with other files (hard link or APFS clone); compressing would break that sharing. Left untouched.</string>
			<key>other</key>
			<string>%lld files in the folder share their space with other files (hard links or APFS clones); compressing would break that sharing. Left untouched.</string>
		</dict>
	</dict>
	<key>%lld Güvenli kalem; her komut silmeden önce gösterilir ve onayını bekler.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@; every command is shown before deleting and waits for your confirmation.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Safe item</string>
			<key>other</key>
			<string>%lld Safe items</string>
		</dict>
	</dict>
	<key>%lld kalem</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
