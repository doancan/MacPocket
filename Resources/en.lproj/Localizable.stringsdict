			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>%lld yer okunamadı (izin yok); bunların boyutu toplamlara dahil değil. Tam Disk Erişimi daha eksiksiz bir tarama sağlar.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@ (no permission); their size is not in the totals. Full Disk Access gives a more complete scan.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
